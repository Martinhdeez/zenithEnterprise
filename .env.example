# Copy to `.env`. Never committed.

# --- Postgres (consumed by docker compose) ---
POSTGRES_USER=zenith
POSTGRES_PASSWORD=zenith
POSTGRES_DB=zenith
POSTGRES_PORT=5432

# --- Backend ---
# Schema owner. Used by migrations and the CLI, never by the API.
ZENITH_DATABASE_OWNER_URL=postgresql+psycopg://zenith:zenith@localhost:5432/zenith
# Application role, subject to RLS. This is what the API must use.
ZENITH_DATABASE_URL=postgresql+psycopg://zenith_app:change-me@localhost:5432/zenith

ZENITH_TEI_EMBED_URL=http://localhost:8081
ZENITH_TEI_RERANK_URL=http://localhost:8082

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ZENITH_JWT_SECRET=change-in-production
# Encrypts the provider API key a tenant stores in `llm_config`. May be left empty on an
# installation using the local model below, which needs no key — but if it is set, it must
# be a valid Fernet key or the service refuses to start.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ZENITH_ENCRYPTION_KEY=

# --- Generation (mvp.md 5.4) ---
# The fallback used when a tenant has not configured its own connector. Any endpoint that
# speaks OpenAI-compatible /v1/chat/completions: Ollama, vLLM, llama.cpp, or a gateway.
# Llama 3.1 8B is the fixed development and CI baseline deliberately — it is the floor, and
# a citation format that survives it survives anything a customer plugs in.
# Which adapter runs: openai | mock. An unknown value fails at the first question
# with the valid list, rather than falling back to something nobody chose.
ZENITH_LLM_PROVIDER=openai
ZENITH_LLM_ENDPOINT_URL=http://localhost:11434/v1
ZENITH_LLM_MODEL=llama3.1:8b-instruct-q4_K_M
# Empty for a local model. Remote providers put their key here, or a tenant stores its own.
ZENITH_LLM_API_KEY=

# Where uploaded documents are stored, content-addressed by SHA-256. Must be absolute:
# a relative path resolves against the working directory, so a service restarted from
# elsewhere would find an empty corpus and report nothing wrong.
ZENITH_STORAGE_DIR=/var/lib/zenith/documents

# --- Limits (mvp.md 2.12) ---
ZENITH_MAX_FILE_BYTES=104857600
ZENITH_MAX_DOCUMENTS_PER_TENANT=5000
ZENITH_MAX_PAGES_PER_DOCUMENT=3000
ZENITH_MAX_QUERIES_PER_MINUTE_USER=30
ZENITH_MAX_QUERIES_PER_MINUTE_TENANT=120

# --- Partitioning (docs/partitioning-modulus.md) ---
# How many hash buckets migration 0026 cuts `chunks` and `chunk_embeddings` into. Read once,
# by that migration, at the moment it partitions; changing it afterwards does nothing until
# 0026 is run again.
#
# The right value is a property of *this* installation and not of the product. A tenant's
# search reaches its own rows plus about one modulus-th of everybody else's, so:
#
#     modulus >= (1 - s) / (epsilon * s)
#
# holds your largest customer, which owns share `s` of the corpus, to `epsilon` extra rows.
# Largest customer holds half the corpus: 32 at 5%. A fifth: 128. A twentieth: 512.
#
# 128 is the default because it covers the wide case, not because it is right for a
# particular one — and larger is not safer. Planning time roughly triples for every doubling
# of the modulus while the benefit halves, so going higher buys a fraction of a per cent and
# costs tens of milliseconds on every search. `zenith diagnose` reads the live per-tenant row
# counts and says which modulus this installation's own corpus asks for.
#
# Raising it means raising POSTGRES_MAX_LOCKS_PER_TRANSACTION in docker/docker-compose.yml
# too: a search takes `9 x modulus + 9` relation locks at planning time, and 0026 refuses to
# run below `4 x modulus`.
ZENITH_PARTITION_MODULUS=128

# --- Hardware profile ---
# gpu | cpu | low-spec. Selects the profile table in `app/core/hardware.py`; an unknown
# value fails at startup rather than falling back to defaults that will run out of memory.
# The three settings below must match the profile chosen here.
ZENITH_HARDWARE=low-spec
TEI_MAX_BATCH_TOKENS=2048
TEI_MAX_CLIENT_BATCH_SIZE=4
ZENITH_WORKER_CONCURRENCY=1

# --- TEI image ---
# CPU by default. For GPU, overlay docker/docker-compose.gpu.yml
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.8
