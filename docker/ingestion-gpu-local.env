# Public preset. Load AFTER the installation's private environment file.
# Apply docker-compose.gpu.yml and the existing Blackwell overlay on RTX 50-series.
# Profile and both TEI services use the same batch limits; CPU defaults are untouched.
ZENITH_HARDWARE=gpu-local
ZENITH_WORKER_CONCURRENCY=1
TEI_MAX_BATCH_TOKENS=4096
TEI_MAX_CLIENT_BATCH_SIZE=8
TEI_RERANK_MODEL=BAAI/bge-reranker-v2-m3
TEI_CPUS=4.0
TEI_GPU_MAX_CONCURRENT_REQUESTS=8
TEI_GPU_DTYPE=float16
