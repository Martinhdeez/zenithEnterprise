
# macOS
.DS_Store

# project-init managed
.notes/
.scratch/
.archived/

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# environment
#
# `.env` alone was not enough. Anything that backs the file up beside itself —
# `.env.bak`, `.env.local`, a timestamped copy made before editing — is untracked rather
# than ignored, and an untracked file holding the JWT secret, the encryption key and every
# database password is one `git add -A` away from being committed. That happened during
# performance tuning and was caught by hand.
#
# The examples are re-admitted explicitly: they carry no secrets and are how a new
# installation learns what to set.
.env
.env.*
!.env.example
!backend/.env.example

# node
# No trailing slash. `node_modules/` matches directories only, so a *symlink* named
# node_modules is not ignored — it gets committed, and merging that commit replaces the
# real directory on the other side with a link. That has now happened twice, once
# self-referential, and both times it took the whole install with it.
node_modules
dist/

# Playwright MCP scratch output (screenshots, snapshots, console logs)
.playwright-mcp/
# Leading slash so this catches a screenshot dropped at the repo root and nothing else —
# `*.png` unqualified would also swallow `frontend/public/`, which holds the favicon and
# the logo the application actually ships.
/*.png

# Uploaded documents. `ZENITH_STORAGE_DIR` points here in local development, so this is
# real tenant content — the PDFs somebody dragged into the upload form — not fixtures.
# It reached 6.9 MB of customer files before anyone noticed it was untracked rather than
# ignored, which is the wrong way round for a directory holding documents whose whole
# point is that only certain roles may read them.
backend/.data/

# Claude Code scratch screenshots; the skills/ directory below is real project config.
.claude/*.png

# Backups hold customer documents and a full database dump. Never in the repository.
backups/
