# Copy to `.env` and fill in. The application refuses to start without a real
# ZENITH_JWT_SECRET — there is no default, deliberately.
#
#   uv run zenith generate-secret
#
# Rotating this value signs everyone out: existing access and refresh tokens stop
# validating immediately.
ZENITH_JWT_SECRET=

# Application role. Subject to RLS — this is what the API and the workers use.
ZENITH_DATABASE_URL=postgresql+psycopg://zenith_app:change-me@localhost:5432/zenith

# Schema owner. Bypasses RLS. Migrations and the install CLI only; never the API.
ZENITH_DATABASE_OWNER_URL=postgresql+psycopg://zenith:zenith@localhost:5432/zenith

ZENITH_TEI_EMBED_URL=http://localhost:8081
ZENITH_TEI_RERANK_URL=http://localhost:8082

# Fernet key protecting customer API keys at rest. Not read yet; required once the
# generation connector exists.
ZENITH_ENCRYPTION_KEY=

# Where uploaded documents are stored, content-addressed by SHA-256. Must be absolute:
# a relative path resolves against the working directory, so a service restarted from
# elsewhere would find an empty corpus and report nothing wrong.
ZENITH_STORAGE_DIR=/var/lib/zenith/documents

# gpu | cpu | low-spec. See `app/core/hardware.py`. Must match the --max-batch-tokens and
# --max-client-batch-size the TEI container was started with.
ZENITH_HARDWARE=cpu
